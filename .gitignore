# ---- Cached artifacts ----
cache/
**/cache/*

**/nul

# ---- R serialized objects ----
*.rds
*.RData

# ---- Generated crosswalk CSVs (built by preprocess/build_nace_crf_crosswalks.R) ----
preprocess/crosswalks/*.csv

# ---- PDFs (copyrighted papers) ----
articles/*.pdf
articles/

# ---- Node.js ----
node_modules/
package.json
package-lock.json

# ---- Output CSVs: regenerable; not pushed ----
# All CSVs under output_*/tables/ (and the legacy output/tables/) are
# regenerable from the analysis scripts and can blow past push limits at
# full sample size. Keep PDFs/PNGs tracked.
# (data/concordances/, data/io/ are NOT covered by this rule.)
output_*/tables/*.csv
output/tables/*.csv
